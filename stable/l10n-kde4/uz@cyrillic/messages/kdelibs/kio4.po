msgstr ""

#: kio/global.cpp:858
msgid "You may not have permissions to read from the resource."
msgstr "Манбадан ўқишга ҳуқуқингиз йўқ бўлиши мумкин."

#: kio/global.cpp:867
msgid "Cannot Write to Resource"
msgstr "Манбага ёзиб бўлмади"

#: kio/global.cpp:868
#, kde-format
msgid ""
"This means that although the resource, <strong>%1</strong>, was able to be "
"opened, an error occurred while writing to the resource."
msgstr ""

#: kio/global.cpp:871
msgid "You may not have permissions to write to the resource."
msgstr "Манбага ёзишга ҳуқуқингиз йўқ бўлиши мумкин."

#: kio/global.cpp:880 kio/global.cpp:891
msgid "Could Not Listen for Network Connections"
msgstr ""

#: kio/global.cpp:881
msgid "Could Not Bind"
msgstr ""

#: kio/global.cpp:882 kio/global.cpp:893
msgid ""
