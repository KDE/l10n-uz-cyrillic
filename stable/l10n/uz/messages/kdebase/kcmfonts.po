#: fonts.cpp:505
msgid "Desktop"
msgstr "Иш столи"

#: fonts.cpp:539
msgid "Used for normal text (e.g. button labels, list items)."
msgstr "Оддий матн (м-н тугма ёзуви, рўйхат бандлари) учун ишлатилади."

#: fonts.cpp:540
msgid "A non-proportional font (i.e. typewriter font)."
msgstr "Мутаносиб эмас шрифт."

#: fonts.cpp:541
msgid "Used to display text beside toolbar icons."
msgstr "Нишончалар ёнидаги матн учун ишлатилади."

#: fonts.cpp:542
msgid "Used by menu bars and popup menus."
msgstr "Меню ва контекст менюси учун ишлатилади."

#: fonts.cpp:543
msgid "Used by the window titlebar."
msgstr "Ойнанинг сарлавҳаси учун ишлатилади."

#: fonts.cpp:544
msgid "Used by the taskbar."
msgstr "Вазифалар панели учун ишлатилади."

#: fonts.cpp:545
msgid "Used for desktop icons."
msgstr "Иш столидаги нишончалар учун ишлатилади."

#: fonts.cpp:596
msgid "Ad&just All Fonts..."
msgstr "Ҳамма ш&рифтларни мослаш"

#: fonts.cpp:597
msgid "Click to change all fonts"
msgstr "Ҳамма шрифтларни ўзгартириш учун шу ерни босинг"

#: fonts.cpp:604
msgid "Use a&nti-aliasing for fonts"
msgstr "Текис &шрифтлардан фойдаланиш"

#: fonts.cpp:605
msgid ""
"If this option is selected, KDE will smooth the edges of curves in fonts."
msgstr "Агар белгиланса, KDE шрифтлардаги ҳарфларнинг ёнларини текислайди."

#: fonts.cpp:608
msgid "Configure..."
msgstr "Мослаш"

#: fonts.cpp:684
msgid ""
"<p>You have changed anti-aliasing related settings. This change will only "
"affect newly started applications.</p>"
msgstr ""
"<p>Сиз шрифтларни текислашга таълуқли мосламаларни ўзгартирдингиз. Киритилган "
"ўзгаришлар фақат янгидан ишга туширилган дастурларга қўлланади.</p>"

#: fonts.cpp:685
msgid "Anti-Aliasing Settings Changed"
msgstr "Шрифтларни текислаш мосламалари ўзгарди"

