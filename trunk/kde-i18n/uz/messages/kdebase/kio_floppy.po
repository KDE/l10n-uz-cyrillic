#: kio_floppy.cpp:200
msgid ""
"drive %1.\n"
"The drive is still busy.\n"
"Wait until it has stopped working and then try again."
msgstr ""
"ускуна %1.\n"
"Ускуна ҳали ҳам банд.\n"
"Унинг иши тугагунча кутиб туринг ва яна "
"уриниб кўринг."

#: kio_floppy.cpp:204 kio_floppy.cpp:1128
msgid ""
"\n"
"The disk in drive %1 is probably full."
msgstr ""
"\n"
"Эҳтимол %1 ускунасидаги дискет тўлган."

#: kio_floppy.cpp:214
#, c-format
msgid ""
"\n"
"There is probably no disk in the drive %1"
msgstr ""
"\n"
"Эҳтимол %1 ускунасида ҳеч қандай диск йўқ."

#: kio_floppy.cpp:218
msgid ""
"\n"
"There is probably no disk in the drive %1 or you do not have enough "
"permissions to access the drive."
msgstr ""
"\n"
"Эҳтимол %1 ускунасида ҳеч қандай диск йўқ "
"ёки уни ўқиш учун сизда етарли ҳуқуқлар "
"йўқ."

#: kio_floppy.cpp:222
msgid ""
"\n"
"The drive %1 is not supported."
msgstr ""
"\n"
"%1 ускунаси қўлланмаган."

#: kio_floppy.cpp:227
msgid ""
"\n"
"Make sure the floppy in drive %1 is a DOS formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"\n"
"%1 ускунасидаги дискет DOS учун формат "
"қилинганлигига ва\n"
"ускуна файлининг (м-н /dev/fd0) ҳуқуқлари "
"тўғри ўрнатилганлигига (м-н rwxrwxrwx) ишонч "
"ҳосил қилинг."

#: kio_floppy.cpp:231
msgid ""
"\n"
"The disk in drive %1 is probably not a DOS formatted floppy disk."
msgstr ""
"\n"
"Эҳтимол %1 ускунасидаги дискет DOS учун "
"формат қилинмаган."

#: kio_floppy.cpp:235
msgid ""
"\n"
"The disk in drive %1 is probably write-protected."
msgstr ""
"\n"
"Эҳтимол %1 ускунасидаги дискет ёзишдан "
"ҳимояланган."

#: kio_floppy.cpp:279 kio_floppy.cpp:516 kio_floppy.cpp:607 kio_floppy.cpp:740
#: kio_floppy.cpp:817 kio_floppy.cpp:903 kio_floppy.cpp:983
#: kio_floppy.cpp:1082
msgid ""
"\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"\n"
"Mtools пакети тўғри ўрнатилганлигига ишонч "
"ҳосил қилинг."

#: kio_floppy.cpp:563 kio_floppy.cpp:578 kio_floppy.cpp:582 kio_floppy.cpp:652
msgid "Reason unknown."
msgstr "Номаълум сабаб."

