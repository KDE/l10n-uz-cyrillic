msgid "Host:"
msgstr "Компьютер:"

#: ksgrd/HostConnector.cc:54
msgid "Enter the name of the host you want to connect to."
msgstr ""
"Сиз уланмоқчи бўлган компьютернинг "
"номини киритинг."

