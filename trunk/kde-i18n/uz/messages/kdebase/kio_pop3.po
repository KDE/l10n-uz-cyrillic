#: pop3.cc:223
msgid "PASS <your password>"
msgstr "PASS <махфий сўзингиз>"

#: pop3.cc:226
msgid "The server said: \"%1\""
msgstr "Сервердан олинган хабар: \"%1\""

#: pop3.cc:252
msgid "The server terminated the connection."
msgstr "Сервер алоқани узди."

#: pop3.cc:254
msgid ""
"Invalid response from server:\n"
"\"%1\""
msgstr ""

#: pop3.cc:285
msgid ""
"Could not send to server.\n"
msgstr ""
"Серверга жўнатиб бўлмади.\n"

#: pop3.cc:356 pop3.cc:552
msgid ""
"Could not login to %1.\n"
"\n"
msgstr ""
"%1 билан алоқа ўрнатиб бўлмади.\n"
"\n"

#: pop3.cc:359
msgid "The server terminated the connection immediately."
msgstr "Сервер алоқани дарҳол узди."

#: pop3.cc:360
msgid ""
"Server does not respond properly:\n"
"%1\n"
msgstr ""
"Сервер тўғри жавоб бермайди:\n"
"%1\n"

#: pop3.cc:385
msgid ""
"Your POP3 server does not support APOP.\n"
"Choose a different authentication method."
msgstr ""
"POP3 сервери APOP тасдиқлаш усулини "
"қўлламайди.\n"
"Тасдиқлашнинг бошқа усулини танланг."

#: pop3.cc:404
msgid ""
"Your POP3 server claims to support TLS but negotiation was unsuccessful. You "
"can disable TLS in KDE using the crypto settings module."
msgstr ""

#: pop3.cc:414
msgid ""
"Your POP3 server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""

#: pop3.cc:425
msgid "Username and password for your POP3 account:"
msgstr ""

#: pop3.cc:471
#, c-format
msgid ""
"Login via APOP failed. The server may not support APOP, although it claims "
"to support it, or the password may be wrong.\n"
"\n"
"%1"
msgstr ""

#: pop3.cc:528
msgid ""
"Login via SASL (%1) failed. The server may not support %2, or the password "
"may be wrong.\n"
"\n"
"%3"
msgstr ""

#: pop3.cc:543
msgid ""
"Your POP3 server does not support SASL.\n"
"Choose a different authentication method."
msgstr ""
"POP3 сервери SASL тасдиқлаш усулини "
"қўлламайди.\n"
"Тасдиқлашнинг бошқа усулини танланг."

#: pop3.cc:572
msgid ""
"Could not login to %1. The password may be wrong.\n"
"\n"
"%2"
msgstr ""
"%1 билан алоқа ўрнатиб бўлмади. Эҳтимол, "
"махфий сўз нотўғри.\n"
"\n"
"%2"

#: pop3.cc:755 pop3.cc:764 pop3.cc:903
msgid "Unexpected response from POP3 server."
msgstr "POP серверидан кутилмаган жавоб."
