#: kcmcss.cpp:231
msgid ""
"<h1>Konqueror Stylesheets</h1> This module allows you to apply your own "
"color and font settings to Konqueror by using stylesheets (CSS). You can "
"either specify options or apply your own self-written stylesheet by pointing "
"to its location."
"<br> Note that these settings will always have precedence before all other "
"settings made by the site author. This can be useful to visually impaired "
"people or for web pages that are unreadable due to bad design."
msgstr ""

#: rc.cpp:2 rc.cpp:4
#, no-c-format
msgid ""
"<b>Stylesheets</b>"
"<p>See http://www.w3.org/Style/CSS for further information on cascading "
"style sheets.</p>"
msgstr ""

#: rc.cpp:6
#, no-c-format
msgid "&General"
msgstr "&Умумий"

#: rc.cpp:8
#, no-c-format
msgid "Stylesheets"
msgstr ""

#: rc.cpp:10
#, no-c-format
msgid ""
"<b>Stylesheets</b>"
"<p>Use this groupbox to determine how Konqueror will render style sheets.</p>"
msgstr ""

#: rc.cpp:12
#, no-c-format
msgid "Use &user-defined stylesheet"
msgstr ""

#: rc.cpp:14
#, no-c-format
msgid ""
"<b>Use user-defined stylesheet</b>"
"<p>If this box is checked, Konqueror will try to load a user-defined style "
"sheet as specified in the location below. The style sheet allows you to "
"completely override the way web pages are rendered in your browser. The file "
"specified should contain a valid style sheet (see "
"http://www.w3.org/Style/CSS for further information on cascading style "
"sheets).</p>"
msgstr ""

#: rc.cpp:16
#, no-c-format
msgid "U&se accessibility stylesheet defined in \"Customize\"-tab"
msgstr ""

#: rc.cpp:18
#, no-c-format
msgid ""
"<b>Use accessibility stylesheet defined in "
"&quot;Customize&quot;-tab</b>"
"<p>"
"Selecting this option will allow you to define a default font, font size, "
"and font color with a few simple clicks of the mouse. Simply wander over to "
"the Customize tab and pick out your desired options.</p>"
msgstr ""

#: rc.cpp:20
#, no-c-format
msgid "Us&e default stylesheet"
msgstr ""

#: rc.cpp:22
#, no-c-format
msgid ""
"<b>Use default stylesheet</b>"
"<p>Select this option to use the default stylesheet.</p>"
msgstr ""

#: rc.cpp:24
#, no-c-format
msgid "Custom&ize"
msgstr "&Мослаш"

#: rc.cpp:26
#, no-c-format
msgid "Colors"
msgstr "Ранглар"

#: rc.cpp:28
#, no-c-format
msgid "&Black on white"
msgstr "&Оқда қора"

#: rc.cpp:30
#, no-c-format
msgid "<b>Black on White</b><p>This is what you normally see.</p>"
msgstr ""
"<b>Оқда қора</b>"
"<p>Одатда ишлатиладиган ранглар.</p>"

#: rc.cpp:32
#, no-c-format
msgid "&White on black"
msgstr "Қо&рада оқ"

#: rc.cpp:34
#, no-c-format
msgid "<b>White on Black</b><p>This is your classic inverse color scheme.</p>"
msgstr ""
"<b>Оқда қора</b>"
"<p>Одатда ишлатиладиган ранглар.</p>"

#: rc.cpp:36
#, no-c-format
msgid "Cus&tom"
msgstr "&Бошқа"

#: rc.cpp:38
#, no-c-format
msgid ""
"<b>Custom</b>"
"<p>Select this option to define a custom color for the default font.</p>"
msgstr ""

#: rc.cpp:41 rc.cpp:45
#, no-c-format
msgid ""
"<b>Foreground color</b>"
"<p>The foreground color is the color that the text is drawn in.</p>"
msgstr ""

#: rc.cpp:43
#, no-c-format
msgid "&Foreground:"
msgstr "&Олдин фон:"

#: rc.cpp:48
#, no-c-format
msgid ""
"<b>Background</b>"
"<p>Behind this door lays the ability to choose a custom default "
"background.</p>"
msgstr ""

#: rc.cpp:50
#, no-c-format
msgid "Bac&kground:"
msgstr "Орқа &фон:"

#: rc.cpp:52
#, no-c-format
msgid ""
"<b>Background</b>"
"<p>This background color is the one displayed behind the text by default. A "
"background image will override this.</p>"
msgstr ""

#: rc.cpp:54
#, no-c-format
msgid "Use same color for all text"
msgstr "Ҳамма матнлар учун битта рангни ишлатиш"

#: rc.cpp:56
#, no-c-format
msgid ""
"<b>Use same color for all text</b>"
"<p>"
"Select this option to apply your chosen color to the default font as well as "
"any custom fonts as specified in a stylesheet.</p>"
msgstr ""

#: rc.cpp:58
#, no-c-format
msgid "Images"
msgstr "Расмлар"

#: rc.cpp:60
#, no-c-format
msgid "<b>Images</b><p>"
msgstr "<b>Расмлар</b><p>"

#: rc.cpp:62
#, no-c-format
msgid "&Suppress images"
msgstr "&Расмларни кўрсатмаш"

#: rc.cpp:64
#, no-c-format
msgid ""
"<b>Suppress images</b>"
"<p>Selecting this will prevent Konqueror from loading images.</p>"
msgstr ""
"<b>Расмларни кўрсатмаш</b>"
"<p>Агар танланса, Konqueror расмларни "
"кўрсатмайди.</p>"

#: rc.cpp:66
#, no-c-format
msgid "Suppress background images"
msgstr "Орқа фон расмларини кўрсатмаш"

#: rc.cpp:68
#, no-c-format
msgid ""
"<b>Suppress background images</b>"
"<p>Selecting this option will prevent Konqueror from loading background "
"images.</p>"
msgstr ""
"<b>Орқа фон расмларини кўрсатмаш</b>"
"<p>"
"Агар танланса, Konqueror орқа фон расмларини "
"кўрсатмайди.</p>"

#: rc.cpp:70
#, no-c-format
msgid "&Preview"
msgstr "Кўриб &чиқиш"

#: rc.cpp:72
#, no-c-format
msgid ""
"<b>Preview</b>"
"<p>Click on this button to see what your selections look like in action.</p>"
msgstr ""
"<b>Кўриб чиқиш</b>"
"<p>Киритилган ўзгаришлар амалда қандай "
"кўринишини кўриш учун шу тугмани "
"босинг.</p>"

#: rc.cpp:74
#, no-c-format
msgid "Font Family"
msgstr "Шрифт оиласи"

#: rc.cpp:76
#, no-c-format
msgid ""
"<b>Font family</b>"
"<p>A font family is a group of fonts that resemble one another, with family "
"members that are e.g. bold, italic, or any number of the above.</p>"
msgstr ""

