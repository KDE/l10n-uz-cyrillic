"Илтимос фойдаланувчи исмингиз билан "
"махфий сўзингизни киритинг."

#: kio_sftp.cpp:664
msgid "Incorrect username or password"
msgstr ""
"Фойдаланувчининг исми ёки махфий сўзи "
"нотўғри"

#: kio_sftp.cpp:670
msgid "Please enter a username and password"
msgstr ""
"Илтимос фойдаланувчи исмингиз билан "
"махфий сўзингизни киритинг."

#: kio_sftp.cpp:730
msgid "Warning: Cannot verify host's identity."
msgstr ""

#: kio_sftp.cpp:741
msgid "Warning: Host's identity changed."
msgstr ""

#: kio_sftp.cpp:752 kio_sftp.cpp:753
msgid "Authentication failed."
msgstr "Тасдиқлаш муваффақиятсиз тугади."

#: kio_sftp.cpp:767
msgid "Connection failed."
msgstr "Алоқа ўрнатиш муваффақиятсиз тугади."

#: kio_sftp.cpp:768 ksshprocess.cpp:808 ksshprocess.cpp:955
msgid "Connection closed by remote host."
msgstr ""
"Алоқа масофадаги компьютер томонидан "
"узилди."

#: kio_sftp.cpp:830
#, c-format
msgid "SFTP version %1"
msgstr "SFTP версияси %1"

#: kio_sftp.cpp:836
msgid "Protocol error."
msgstr "Протоколнинг хатоси."

#: kio_sftp.cpp:842
#, c-format
msgid "Successfully connected to %1"
msgstr "%1 билан алоқа муваффақиятли ўрнатилди"

#: kio_sftp.cpp:940
msgid "Could not copy file to '%1'"
msgstr ""

#: kio_sftp.cpp:1094
msgid "An internal error occurred. Please try again."
msgstr ""

#: kio_sftp.cpp:1114
msgid ""
"Unknown error was encountered while copying the file to '%1'. Please try "
"again."
msgstr ""

#: kio_sftp.cpp:1373
msgid "The remote host does not support renaming files."
msgstr ""
"Масофадаги компьютер файлларнинг номини "
"ўзгартиришни қўлламайди."

#: kio_sftp.cpp:1425
msgid "The remote host does not support creating symbolic links."
msgstr ""
"Масофадаги компьютер рамзий боғларни "
"яратишни қўлламайди."

#: kio_sftp.cpp:1545
msgid "Could not allocate memory for SFTP packet."
msgstr ""
"SFTP пакети учун хотирадан жой ажратиб "
"бўлмади."

#: kio_sftp.cpp:1556
msgid "Connection closed"
msgstr "Алоқа узилди"

#: kio_sftp.cpp:1563
msgid "Could not read SFTP packet"
msgstr "SFTP пакетини ўқиб бўлмади."

#: kio_sftp.cpp:1667
msgid "SFTP command failed for an unknown reason."
msgstr ""
"SFTP буйруғи номаълум сабабларга кўра "
"муваффақиятсиз тугади."

#: kio_sftp.cpp:1671
msgid "The SFTP server received a bad message."
msgstr "SFTP сервери ёмон хабарни қабул қилди."

#: kio_sftp.cpp:1675
msgid "You attempted an operation unsupported by the SFTP server."
msgstr "Сиз уринган амални SFTP сервери қўлламайди."

#: kio_sftp.cpp:1679
#, c-format
msgid "Error code: %1"
msgstr "Хатонинг коди: %1"

#: ksshprocess.cpp:406
msgid "Cannot specify a subsystem and command at the same time."
msgstr ""

#: ksshprocess.cpp:741
msgid "No options provided for ssh execution."
msgstr ""

#: ksshprocess.cpp:749
msgid "Failed to execute ssh process."
msgstr ""

#: ksshprocess.cpp:774 ksshprocess.cpp:803 ksshprocess.cpp:922
#: ksshprocess.cpp:994
msgid "Error encountered while talking to ssh."
msgstr "SSH билан алоқа давомида хато рўй берди."

#: ksshprocess.cpp:854
msgid "Please supply a password."
msgstr "Илтимос махфий сўзни киритинг."

#: ksshprocess.cpp:893
msgid "Please supply the passphrase for your SSH private key."
msgstr ""

#: ksshprocess.cpp:907
msgid "Authentication to %1 failed"
msgstr ""

#: ksshprocess.cpp:930
msgid ""
"The identity of the remote host '%1' could not be verified because the "
"host's key is not in the \"known hosts\" file."
msgstr ""

#: ksshprocess.cpp:936
msgid ""
" Manually, add the host's key to the \"known hosts\" file or contact your "
"administrator."
msgstr ""

#: ksshprocess.cpp:942
msgid " Manually, add the host's key to %1 or contact your administrator."
msgstr ""

#: ksshprocess.cpp:974
msgid ""
"The identity of the remote host '%1' could not be verified. The host's key "
"fingerprint is:\n"
"%2\n"
"You should verify the fingerprint with the host's administrator before "
"connecting.\n"
"\n"
"Would you like to accept the host's key and connect anyway? "
msgstr ""

#: ksshprocess.cpp:1002
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator. The key fingerprint is:\n"
"%2\n"
"Add the correct host key to \"%3\" to get rid of this message."
msgstr ""

#: ksshprocess.cpp:1037
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator before connecting. The key "
"fingerprint is:\n"
"%2\n"
"\n"
"Would you like to accept the host's new key and connect anyway?"
msgstr ""

#: ksshprocess.cpp:1061
msgid "Host key was rejected."
msgstr "Хостнинг калити рад этилди."

