#: kcmaccess.cpp:69
msgid "Audible Bell"
msgstr "Кўринадиган сигнал"

#: kcmaccess.cpp:76
msgid "Use &system bell"
msgstr "&Система товуш сигналидан фойдаланиш"

#: kcmaccess.cpp:78
msgid "Us&e customized bell"
msgstr ""

#: kcmaccess.cpp:80
msgid ""
"If this option is checked, the default system bell will be used. See the "
"\"System Bell\" control module for how to customize the system bell. "
"Normally, this is just a \"beep\"."
msgstr ""

#: kcmaccess.cpp:83
msgid ""
"Check this option if you want to use a customized bell, playing a sound "
"file. If you do this, you will probably want to turn off the system bell."
"<p> Please note that on slow machines this may cause a \"lag\" between the "
"event causing the bell and the sound being played."
msgstr ""

#: kcmaccess.cpp:90
msgid "Sound &to play:"
msgstr "Ўйнаш учун &товуш:"

#: kcmaccess.cpp:95
msgid ""
"If the option \"Use customized bell\" is enabled, you can choose a sound "
"file here. Click \"Browse...\" to choose a sound file using the file dialog."
msgstr ""

#: kcmaccess.cpp:112
msgid "Visible Bell"
msgstr "Кўринадиган сигнал"

#: kcmaccess.cpp:118
msgid "&Use visible bell"
msgstr "Кўринадиган &сигналдан фойдаланиш"

#: kcmaccess.cpp:120
msgid ""
"This option will turn on the \"visible bell\", i.e. a visible notification "
"shown every time that normally just a bell would occur. This is especially "
"useful for deaf people."
msgstr ""

#: kcmaccess.cpp:126
msgid "I&nvert screen"
msgstr ""

#: kcmaccess.cpp:129
msgid "All screen colors will be inverted for the amount of time specified below."
msgstr ""

#: kcmaccess.cpp:131
msgid "F&lash screen"
msgstr ""

#: kcmaccess.cpp:133
msgid ""
"The screen will turn to a custom color for the amount of time specified "
"below."
msgstr ""

#: kcmaccess.cpp:139
msgid "Click here to choose the color used for the \"flash screen\" visible bell."
msgstr ""

#: kcmaccess.cpp:146
msgid "Duration:"
msgstr "Давом этиши:"

#: kcmaccess.cpp:147 kcmaccess.cpp:200 kcmaccess.cpp:218
msgid " msec"
msgstr " мс"

#: kcmaccess.cpp:149
msgid ""
"Here you can customize the duration of the \"visible bell\" effect being "
"shown."
msgstr ""

#: kcmaccess.cpp:166
msgid "&Bell"
msgstr "&Товуш сигнали"

#: kcmaccess.cpp:174
msgid "S&ticky Keys"
msgstr "Ёпишқоқ &тугмалар"

#: kcmaccess.cpp:180
msgid "Use &sticky keys"
msgstr "Ёпишқоқ тугмалардан &фойдаланиш"

#: kcmaccess.cpp:185
msgid "&Lock sticky keys"
msgstr ""

#: kcmaccess.cpp:188
msgid "Slo&w Keys"
msgstr "&Секин тугмалар"

#: kcmaccess.cpp:194
msgid "&Use slow keys"
msgstr "Секин ту&гмалардан фойдаланиш"

#: kcmaccess.cpp:202
msgid "Dela&y:"
msgstr "К&ечикиш:"

#: kcmaccess.cpp:206
msgid "Bounce Keys"
msgstr ""

#: kcmaccess.cpp:212
msgid "Use bou&nce keys"
msgstr ""

#: kcmaccess.cpp:220
msgid "D&elay:"
msgstr "К&ечикиш:"

#: kcmaccess.cpp:237
msgid "&Keyboard"
msgstr "&Тугматаг"

#: kcmaccess.cpp:261
msgid "*.wav|WAV Files"
msgstr "*.wav|WAV-файллари"

