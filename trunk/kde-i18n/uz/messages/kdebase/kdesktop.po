#: minicli.cpp:93
msgid "&Run"
msgstr "&Бажариш"

#: minicli.cpp:385
msgid "<qt>The user <b>%1</b> does not exist on this system.</qt>"
msgstr ""
"<qt>Фойдаланувчи <b>%1</b> системада мавжуд "
"эмас.</qt>"

#: minicli.cpp:395
msgid ""
"You don't exist!\n"
msgstr ""
"Сиз мавжуд эмассиз!\n"

#: minicli.cpp:420
msgid "Incorrect password! Please try again."
msgstr ""
"Махфий сўз нотўғри! Илтимос яна бир марта "
"уриниб кўринг."

#: minicli.cpp:531
msgid ""
