#: lock/lockdlg.cc:75
msgid "<nobr><b>The screen is locked</b><br>"
msgstr "<nobr><b>Экран қулфланган</b><br>"

#: lock/lockdlg.cc:76
msgid "<nobr><b>The screen is locked by %1</b><br>"
msgstr "<nobr><b>Экран %1 томонидан қулфланган</b><br>"

#: lock/lockdlg.cc:86
msgid "&Start New Session"
msgstr "Янги сеансни &бошлаш"

#: lock/lockdlg.cc:187
msgid "<b>Unlocking failed</b>"
msgstr "<b>Экранни очиш муваффақиятсиз тугади</b>"

#: lock/lockdlg.cc:193
msgid "<b>Warning: Caps Lock on</b>"
msgstr "<b>Диққат: CapsLock ёқилган!</b>"

#: lock/lockdlg.cc:417
msgid ""
"Cannot unlock the screen, as the authentication system fails to work.\n"
"You must kill kdesktop_lock (pid %1) manually."
msgstr ""
"Экранни очиб бўлмайди, чунки тасдиқлаш "
"тизими ишламаяпти.\n"
"kdesktop_lock (pid %1) дастурини қўлбаки тўхтатиш "
"керак."

#: lock/lockdlg.cc:515
msgid ""
"You have chosen to open another desktop session instead of resuming the "
"current one."
"<br>The current session will be hidden and a new login screen will be "
"displayed."
"<br>An F-key is assigned to each session; F%1 is usually assigned to the "
"first session, F%2 to the second session and so on. You can switch between "
"sessions by pressing CTRL, ALT and the appropriate F-key at the same time."
msgstr ""
"Сиз жорий сеансни давом этишни ўрнига "
"янги сеансни бошлашни "
"танладингиз."
"<br>Давом этсангиз, жорий сеанс бекитилади "
"ва кириш ойнаси кўрсатилади."
"<br>Ҳар бир сеансга битта функционал тугма "
"белгиланган. Одатда, биринчи сеансга F%1, "
"иккинчи сеансга F%2 ва ҳоказо. Сеансни "
"улисидан-булисига ўтиш учун бир вақтни "
"ичида Ctrl, Alt ва керакли функционал тугмани "
"босиш керак."

#: lock/lockprocess.cc:658
msgid ""
"Will not lock the screen, as unlocking would be impossible:\n"
msgstr ""
"Экранни қулфлаб бўлмайди, чунки кейин уни "
"очиб бўлмайди:\n"

#: lock/lockprocess.cc:662
msgid "Cannot start <i>kcheckpass</i>."
msgstr "<i>kcheckpass</i> дастурини ишга тушириб бўлмади."

#: lock/lockprocess.cc:663
msgid "<i>kcheckpass</i> is unable to operate. Possibly it is not SetUID root."
msgstr ""

#: lock/lockprocess.cc:707
msgid "No appropriate greeter plugin configured."
msgstr "Керакли гритер плагини мосланмаган."

