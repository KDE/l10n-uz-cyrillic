#: kdesu.cpp:57 kdesu.cpp:58
msgid "Specifies the command to run."
msgstr "Бажариш учун буйруқ."

#: kdesu.cpp:59
msgid "Run command under target uid if <file> is not writable."
msgstr ""

#: kdesu.cpp:60
msgid "Specifies the target uid."
msgstr ""

#: kdesu.cpp:61
msgid "Do not keep password."
msgstr "Махфий сўзни эслаб қолмаш."

#: kdesu.cpp:62
msgid "Stop the daemon (forgets all passwords)."
msgstr ""
"Демонни тўхтатиш (ҳамма махфий сўзлар "
"йўқолади)."

#: kdesu.cpp:63
msgid "Enable terminal output (no password keeping)."
msgstr ""

#: kdesu.cpp:64
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest."
msgstr ""
"Муҳимлик даражасини кўрсатиш: 0 <= муҳ. дар "
"<= 100."

#: kdesu.cpp:65
msgid "Use realtime scheduling."
msgstr ""

#: kdesu.cpp:66
msgid "Let command use existing dcopserver."
msgstr "Мавжуд dcopserver хизматидан фойдаланиш."

#: kdesu.cpp:97
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:98
msgid "Runs a program with elevated privileges."
msgstr ""

#: kdesu.cpp:101
msgid "Maintainer"
msgstr "Таъминловчи"

#: kdesu.cpp:103
msgid "Original author"
msgstr "Биринчи муаллиф"

#: kdesu.cpp:122
msgid "Command '%1' not found."
msgstr "\"%1\" буйруғи топилмади."

#: kdesu.cpp:190
#, c-format
msgid "Illegal priority: %1"
msgstr "Муҳимлик даражаси хато: %1"

#: kdesu.cpp:218
msgid "No command specified!"
msgstr "Ҳеч қандай буйруқ кўрсатилмаган!"

#: kdesu.cpp:323
msgid ""
"Su returned with an error!\n"
msgstr ""
"Su дастури хато билан тугади!\n"

#: kdesu.cpp:343
msgid "Command:"
msgstr "Буйруқ:"

#: kdesu.cpp:348
msgid "realtime: "
msgstr ""

#: kdesu.cpp:350
msgid "Priority:"
msgstr "Муҳимлик даражаси:"

#: sudlg.cpp:21
#, c-format
msgid "Run as %1"
msgstr "%1 сифатида ишга тушириш"

#: sudlg.cpp:25
msgid ""
"The action you requested needs root privileges. Please enter root's password "
"below or click Ignore to continue with your current privileges."
msgstr ""
"Талаб қилинган амални бажариш учун "
"root'нинг имтиёзлари керак. Илтимос root'нинг "
"махфий сўзини киритинг ёки сизнинг жорий "
"имтиёзларингиз билан давом этиш учун "
"\"Эътибор бермаш\" тугмасини босинг."

#: sudlg.cpp:29
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for \"%1\" below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Талаб қилинган амални бажариш қўшимча "
"имтиёзлар керак. Илтимос \"%1\"нинг махфий "
"сўзини киритинг ёки сизнинг жорий "
"имтиёзларингиз билан давом этиш учун "
"\"Эътибор бермаш\" тугмасини босинг."

#: sudlg.cpp:34
msgid "&Ignore"
msgstr "&Эътибор бермаш"

#: sudlg.cpp:50
msgid "Conversation with su failed."
msgstr ""
"Su дастури билан алоқа муваффақиятсиз "
"тугади."

#: sudlg.cpp:59
msgid ""
"The program 'su' is not found!\n"
"Make sure your PATH is set correctly."
msgstr ""
"\"su\" дастури топилмади!\n"
"Илтимос \"su\" дастури тўғри "
"ўтнатилганлигини ва у ўрнатилган "
"директория сизнинг $PATH ўзгарувчингизга "
"киритилганлигини текширинг."

#: sudlg.cpp:66
msgid ""
"You are not allowed to use 'su'!\n"
"On some systems, you need to be in a special group (often: wheel) to use "
"this program."
msgstr ""
"Su дастурини ишлатиш учун сизга рухсат "
"йўқ. Баъзи бир системаларда уни ишлатиш "
"учун фойдаланувчи махсус гуруҳда (одатда "
"wheel) бўлиши керак."

#: sudlg.cpp:73
msgid "Incorrect password! Please try again."
msgstr ""
"Махфий сўз нотўғри! Илтимос яна бир марта "
"уриниб кўринг."

#: sudlg.cpp:77
msgid "Internal error: Illegal return from SuProcess::checkInstall()"
msgstr ""
"Ички хато: SuProcess::checkInstall() нотўғри қийматни "
"қайтарди."

