#: filetemplates.cpp:548
msgid "Manage File Templates"
msgstr "Файл намуналарини бошқариш"

#: filetemplates.cpp:565
msgid "&Template:"
msgstr "&Намуна:"

#: filetemplates.cpp:570
msgid ""
"<p>This string is used as the template's name and is displayed, for example, "
"in the Template menu. It should describe the meaning of the template, for "
"example 'HTML Document'.</p>"
msgstr ""

#: filetemplates.cpp:575
msgid "Press to select or change the icon for this template"
msgstr "Ушбу намуна учун нишончани ўзгартириш ёки танлаш учун босинг"

#: filetemplates.cpp:577
msgid "&Group:"
msgstr "&Гуруҳ:"

#: filetemplates.cpp:581
msgid ""
"<p>The group is used for chosing a submenu for the plugin. If it is empty, "
"'Other' is used.</p><p>You can type any string to add a new group to your "
"menu.</p>"
msgstr ""

#: filetemplates.cpp:585
msgid "Document &name:"
msgstr "Ҳужжатнинг &номи:"

#: filetemplates.cpp:588
msgid ""
"<p>This string will be used to set a name for the new document, to display "
"in the title bar and file list.</p><p>If the string contains '%N', that will "
"be replaced with a number increasing with each similarly named file.</p><p> "
"For example, if the Document Name is 'New shellscript (%N).sh', the first "
"document will be named 'New shellscript (1).sh', the second 'New shellscipt "
"(2).sh', and so on.</p>"
msgstr ""

#: filetemplates.cpp:596
msgid "&Highlight:"
msgstr ""

#: filetemplates.cpp:597
msgid "None"
msgstr "Йўқ"

#: filetemplates.cpp:599
msgid ""
"<p>Select the highlight to use for the template. If 'None' is chosen, the "
"property will not be set.</p>"
msgstr ""

#: filetemplates.cpp:602
msgid "&Description:"
msgstr "&Таърифи:"

#: filetemplates.cpp:605
msgid ""
"<p>This string is used, for example, as context help for this template (such "
"as the 'whatsthis' help for the menu item.)</p>"
msgstr ""

#: filetemplates.cpp:609
msgid "&Author:"
msgstr "&Муаллиф:"

#: filetemplates.cpp:612
msgid ""
"<p>You can set this if you want to share your template with other users.</"
"p><p>the recommended form is like an Email address: 'Anders Lund &lt;"
"anders@alweb.dk&gt;'</p>"
msgstr ""

#: filetemplates.cpp:692
msgid ""
"<p>If you want to base this template on an existing file or template, select "
"the appropriate option below.</p>"
msgstr ""

#: filetemplates.cpp:699
msgid "Start with an &empty document"
msgstr "&Бўш ҳужжат билан бошлаш"

#: filetemplates.cpp:704
msgid "Use an existing file:"
msgstr "Мавжуд файлни ишлатиш:"

#: filetemplates.cpp:715
msgid "Use an existing template:"
msgstr "Мавжуд намунани ишлатиш:"

#: filetemplates.cpp:745
#, fuzzy
msgid "Chose Template Origin"
msgstr "Намуна плагини"

#: filetemplates.cpp:750
msgid "Edit Template Properties"
msgstr "Намуна мосламасини таҳрирлаш"

#: filetemplates.cpp:770
msgid ""
"<p>Chose a location for the template. If you store it in the template "
"directory, it will automatically be added to the template menu.</p>"
msgstr ""

#: filetemplates.cpp:778
msgid "Template directory"
msgstr "Намуна жилди"

#: filetemplates.cpp:785
msgid "Template &file name:"
msgstr "Намуна &файли номи:"

#: filetemplates.cpp:790
msgid "Custom location:"
msgstr "Манзили:"

#: filetemplates.cpp:804
msgid "Choose Location"
msgstr "Манзилини кўрсатиш"

#: filetemplates.cpp:813
msgid ""
"<p>You can replace certain strings in the text with template macros.<p>If "
"any of the data below is incorrect or missing, edit the data in the KDE "
"email information."
msgstr ""

#: filetemplates.cpp:817
#, qt-format
msgid "Replace full name '%1' with the '%{fullname}' macro"
msgstr ""

#: filetemplates.cpp:822
#, qt-format
msgid "Replace email address '%1' with the '%email' macro"
msgstr ""

#: filetemplates.cpp:829
msgid "Autoreplace Macros"
msgstr "Авто-алмаштириш макрослари"

#: filetemplates.cpp:836
msgid ""
"<p>The template will now be created and saved to the chosen location. To "
"position the cursor put a caret ('^') character where you want it in files "
"created from the template.</p>"
msgstr ""

#: filetemplates.cpp:842
msgid "Open the template for editing"
msgstr "Таҳрирлаш учун намунани очиш"

#: filetemplates.cpp:848
msgid "Create Template"
msgstr "Намуна яратиш"

#: filetemplates.cpp:943
#, qt-format
msgid ""
"<p>The file <br><strong>'%1'</strong><br> already exists; if you do not want "
"to overwrite it, change the template file name to something else."
msgstr ""

#: filetemplates.cpp:946
msgid "File Exists"
msgstr "Файл аллақачон мавжуд"

#: filetemplates.cpp:946
msgid "Overwrite"
msgstr "Алмаштириш"

#: filetemplates.cpp:998
#, qt-format
msgid ""
"<qt>Error opening the file<br><strong>%1</strong><br>for reading. The "
"document will not be created</qt>"
msgstr ""

