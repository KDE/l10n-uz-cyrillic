#: appletproxy.cpp:55
msgid "The applet's desktop file"
msgstr "Апплетнинг .desktop файли"

#: appletproxy.cpp:56
msgid "The config file to be used"
msgstr "Фойдаланиш учун мослама файли"

#: appletproxy.cpp:62 appletproxy.cpp:64
msgid "Panel applet proxy."
msgstr "Панел апплети учун прокси."

#: appletproxy.cpp:86
msgid "No desktop file specified"
msgstr "Ҳеч қандай .desktop файли кўрсатилмаган"

#: appletproxy.cpp:119
msgid ""
"The applet proxy could not be started due to DCOP communication problems."
msgstr ""
"DCOP билан алоқа муаммолари сабабли апплет проксисини ишга тушириб бўлмади."

#: appletproxy.cpp:120 appletproxy.cpp:128 appletproxy.cpp:162
#: appletproxy.cpp:183
msgid "Applet Loading Error"
msgstr "Апплетни юклаш хатоси"

#: appletproxy.cpp:127
msgid ""
"The applet proxy could not be started due to DCOP registration problems."
msgstr ""
"DCOP хизмати рўйхатидан ўтиш муаммолари сабабли апплет проксисини ишга "
"тушириб бўлмади."

#: appletproxy.cpp:161
#, qt-format
msgid "The applet proxy could not load the applet information from %1."
msgstr "Апплет проксиси апплет ҳақида маълумотни '%1'дан юклолмади."

#: appletproxy.cpp:182
#, qt-format
msgid "The applet %1 could not be loaded via the applet proxy."
msgstr "Апплетни '%1' апплет проксиси орқали юклаб бўлмади."

