msgid "Connection closed by remote host."
msgstr "Алоқа масофадаги компьютер томонидан узилди."

#: kio_sftp.cpp:759
#, qt-format
msgid "Unexpected SFTP error: %1"
msgstr "Кутилмаган SFTP хатоси: %1"

