#: kcmsmserver.cpp:48
msgid ""
"<h1>Session Manager</h1> You can configure the session manager here. This "
"includes options such as whether or not the session exit (logout) should be "
"confirmed, whether the session should be restored again when logging in and "
"whether the computer should be automatically shut down after session exit by "
"default."
msgstr ""

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 13
#: rc.cpp:4
#, no-c-format
msgid "Session Manager"
msgstr "Сеанс бошқарувчиси"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 25
#: rc.cpp:8
#, no-c-format
msgid "General"
msgstr "Умумий"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 31
#: rc.cpp:12
#, no-c-format
msgid ""
"Check this option if you want the session manager to display a logout "
"confirmation dialog box."
msgstr "Агар белгиланса, сеансни тугатишда тасдиқлаш учун ойна кўринади."

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 34
#: rc.cpp:16
#, no-c-format
msgid "Conf&irm logout"
msgstr "Чиқишни &тасдиқлаш"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 41
#: rc.cpp:20
#, no-c-format
msgid "O&ffer shutdown options"
msgstr "Ўчириш турларини &таклиф қилиш"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 55
#: rc.cpp:24
#, no-c-format
msgid ""
"<ul>\n"
"<li><b>Restore previous session:</b> Will save all applications running on "
"exit and restore them when they next start up</li>\n"
"<li><b>Restore manually saved session: </b> Allows the session to be saved "
"at any time via \"Save Session\" in the K-Menu. This means the currently "
"started applications will reappear when they next start up.</li>\n"
"<li><b>Start with an empty session:</b> Do not save anything. Will come up "
"with an empty desktop on next start.</li>\n"
"</ul>"
msgstr ""

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 58
#: rc.cpp:32
#, no-c-format
msgid "On Login"
msgstr "Тизимга киришда"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 64
#: rc.cpp:36
#, no-c-format
msgid "Restore &previous session"
msgstr "&Олдинги сеансни қайта тиклаш"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 71
#: rc.cpp:40
#, no-c-format
msgid "Restore &manually saved session"
msgstr "Қўлбола &сақланган сенсларни таклаш"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 78
#: rc.cpp:44
#, no-c-format
msgid "Start with an empty &session"
msgstr "&Бўш сеанс билан бошлаш"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 88
#: rc.cpp:48
#, no-c-format
msgid ""
"Here you can choose what should happen by default when you log out. This "
"only has meaning, if you logged in through KDM."
msgstr ""
"Бу ерда чиқишдан сўнг қайси амал бажарилишини танлашингиз мумкин. Бу тизимга "
"фақат KDM орқали кирилса маънога эга."

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 91
#: rc.cpp:52
#, no-c-format
msgid "Default Shutdown Option"
msgstr "Андоза ўчириш тури"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 97
#: rc.cpp:56
#, no-c-format
msgid "&End current session"
msgstr "&Жорий сеансни тугатиш"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 104
#: rc.cpp:60
#, no-c-format
msgid "&Turn off computer"
msgstr "Ко&мпьютерни ўчириш"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 111
#: rc.cpp:64
#, no-c-format
msgid "&Restart computer"
msgstr "К&омпьютерни ўчириб-ёқиш"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 121
#: rc.cpp:68
#, no-c-format
msgid "Advanced"
msgstr "Қўшимча"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 127
#: rc.cpp:72
#, no-c-format
msgid "Applications to be e&xcluded from sessions:"
msgstr "Сеансга &кирмаган дастурлар:"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 140
#: rc.cpp:76
#, no-c-format
msgid ""
"Here you can enter a comma-separated list of applications that should not be "
"saved in sessions, and therefore will not be started when restoring a "
"session. For example 'xterm,xconsole'."
msgstr ""
"Бу ерда вергул билан ажратилган дастурларнинг номини киритиш мумкин. Улар "
"сеансни тиклаганда ишга туширилмайди. Масалан, 'xterm,xconsole'."
