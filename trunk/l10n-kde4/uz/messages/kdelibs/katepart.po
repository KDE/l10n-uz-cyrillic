msgstr "Катта-кичик &ҳарфни фарқлаш"

#: plugins/autobookmarker/autobookmarker.cpp:301
msgid ""
"<p>If enabled, the pattern matching will be case sensitive, otherwise not.</"
"p>"
msgstr ""

