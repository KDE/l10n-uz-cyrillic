msgid ""
"</p><p>See 'man pppd' for an explanation of the error codes or take a look "
"at the kppp FAQ on   <a href=\"%1\">%1</a></p>"
msgstr ""

#: kpppwidget.cpp:678 main.cpp:284
msgid "Error"
msgstr ""

#: kpppwidget.cpp:678
msgid "&Details"
msgstr "&Тафсилотлар"

#: kpppwidget.cpp:711
msgid ""
"kppp's helper process just died.\n"
"Since further execution would be pointless, kppp will shut down now."
msgstr ""

#: kpppwidget.cpp:753
msgid ""
"Cannot find the PPP daemon!\n"
"Make sure that pppd is installed and that you have entered the correct path."
msgstr ""

#: kpppwidget.cpp:762
#, kde-format
#| msgid ""
#| "kppp cannot execute:\n"
#| " %1\n"
#| "Please make sure that you have given kppp setuid permission and that pppd "
#| "is executable."
msgid ""
"kppp cannot execute:\n"
" %1\n"
"Please make sure that you have given kppp setuid permission and that pppd is "
"executable."
msgstr ""

#: kpppwidget.cpp:783
#, kde-format
#| msgid ""
#| "kppp can not find:\n"
#| " %1\n"
#| "Please make sure you have setup your modem device properly and/or adjust "
#| "the location of the modem device on the modem tab of the setup dialog."
msgid ""
"kppp can not find:\n"
" %1\n"
"Please make sure you have setup your modem device properly and/or adjust the "
"location of the modem device on the modem tab of the setup dialog."
msgstr ""

#: kpppwidget.cpp:800
msgid ""
"You have selected the authentication method PAP or CHAP. This requires that "
"you supply a username and a password."
msgstr ""

#: kpppwidget.cpp:809
