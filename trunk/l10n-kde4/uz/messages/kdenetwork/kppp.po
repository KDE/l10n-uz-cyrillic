"%1\n"
"Falling back to default"
msgstr ""
"Бундай модем мавжуд эмас:\n"
"%1\n"
"Андоза ишлатилади"

#: kpppwidget.cpp:344
#, kde-format
msgid ""
"No such Account:\n"
"%1"
msgstr ""
"Бундай алоқа мавжуд эмас:\n"
"%1"

#: kpppwidget.cpp:414
msgid "KPPP Configuration"
msgstr "KPPP мосламаси"

#: kpppwidget.cpp:424
msgid "&Accounts"
msgstr "&Алоқалар"

#: kpppwidget.cpp:425
msgid "Account Setup"
msgstr "Алоқа мосламаси"

#: kpppwidget.cpp:437
msgid "&Modems"
msgstr "&Модемлар"

#: kpppwidget.cpp:438
msgid "Modems Setup"
msgstr "Модемлар мосламаси"

#: kpppwidget.cpp:445
msgid "&Graph"
msgstr "Чи&зма"

#: kpppwidget.cpp:446
msgid "Throughput Graph"
msgstr ""

#: kpppwidget.cpp:452
msgid "M&isc"
msgstr "Ҳар &хил"

#: kpppwidget.cpp:453
msgid "Miscellaneous Settings"
msgstr "Ҳар хил мосламалар"

