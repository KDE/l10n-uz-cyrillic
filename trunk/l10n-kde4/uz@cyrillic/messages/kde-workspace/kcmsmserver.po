#~ msgid "&End current session"
#~ msgstr "&Жорий сеансни тугатиш"

#~ msgid "&Turn off computer"
#~ msgstr "Ко&мпьютерни ўчириш"

#~ msgid "&Restart computer"
#~ msgstr "К&омпьютерни ўчириб-ёқиш"

#~ msgid "On Login"
#~ msgstr "Тизимга киришда"

