#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Машраб Қуватов"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "kmashrab@uni-bremen.de"

#: rc.cpp:1
msgid "Socks"
msgstr "Socks"

#: rc.cpp:2
msgid "&Enable SOCKS support"
msgstr "SOCKS &қўллашни ёқиш"

#: rc.cpp:3
msgid ""
"Check this to enable SOCKS4 and SOCKS5 support in KDE applications and I/O "
"subsystems."
msgstr ""

#: rc.cpp:4
msgid "SOCKS Implementation"
msgstr "SOCKS амалга оширилиши"

#: rc.cpp:5
msgid "A&uto detect"
msgstr "&Авто-аниқлаш"

#: rc.cpp:6
msgid ""
"If you select Autodetect, then KDE will automatically search for an "
"implementation of SOCKS on your computer."
msgstr ""
"\"Авто-аниқлаш\" танланса, KDE компютеда SOCKS қандай амалга оширилганини "
"автоматик равишда аниқлайди."

#: rc.cpp:7
msgid "&NEC SOCKS"
msgstr "&NEC SOCKS"

#: rc.cpp:8
msgid "This will force KDE to use NEC SOCKS if it can be found."
msgstr "Агар топилса, KDE NEC SOCKS кутубхонасидан фойдаланади."

#: rc.cpp:9
msgid "Use &custom library"
msgstr "&Бошқа кутубхонадан фойдаланиш"

#: rc.cpp:10
msgid ""
"Select custom if you wish to use an unlisted SOCKS library. Please note that "
"this may not always work as it depends on the API of the library which you "
"specify (below)."
msgstr ""

#: rc.cpp:11
msgid "&Path:"
msgstr "Йў&л:"

#: rc.cpp:12
msgid "Enter the path to an unsupported SOCKS library."
msgstr "Қўлланмаган SOCKS кутубхонасига йўллни киритинг."

#: rc.cpp:13
msgid "&Dante"
msgstr "&Dante"

#: rc.cpp:14
msgid "This will force KDE to use Dante if it can be found."
msgstr "Агар топилса, KDE Dante кутубхонасидан фойдаланади."

#: rc.cpp:15
msgid "Additional Library Search Paths"
msgstr "Қўшимча кутубхоналарни қидириш учун йўллар"

#: rc.cpp:16
msgid ""
"Here you can specify additional directories to search for the SOCKS libraries. "
"/usr/lib, /usr/local/lib, /usr/local/socks5/lib and /opt/socks5/lib are already "
"searched by default."
msgstr ""
"Бу ерда, қўшимча кутубхоналарини қидириш учун директорияларни кўрсатишингиз "
"мумкин. Қуйидаги йўллардан андоза бўйича фойдаланилади.\n"
"/usr/lib, /usr/local/lib, /usr/local/socks5/lib, /opt/socks5/lib"

#: rc.cpp:17
msgid "Path"
msgstr "Йўл"

#: rc.cpp:18
msgid "This is the list of additional paths that will be searched."
msgstr "Қўшимча кутубхоналарни қидириш учун йўллар рўйхати."

#: rc.cpp:19
msgid "&Add"
msgstr "&Қўшиш"

#: rc.cpp:21
msgid "&Test"
msgstr "&Синаш"

#: rc.cpp:22
msgid "Click here to test SOCKS support."
msgstr "SOCKS қўлланганини текшириш учун шу ерни босинг."

#: socks.cpp:88
msgid "These changes will only apply to newly started applications."
msgstr ""
"Киритилган ўзгаришлар фақат янгидан ишга туширилган дастурларга қўлланади."

#: socks.cpp:90 socks.cpp:123 socks.cpp:128
msgid "SOCKS Support"
msgstr "SOCKS'ни қўллаш"

#: socks.cpp:122
msgid "Success! SOCKS was found and initialized."
msgstr "Муваффақият! SOCKS топилди ва ишга тайёрланди."

#: socks.cpp:127
msgid "SOCKS could not be loaded."
msgstr "SOCKS'ни юклаб бўлмади."

#: socks.cpp:266
msgid ""
"<h1>SOCKS</h1><p>This module allows you to configure KDE support for a SOCKS "
"server or proxy.</p><p>SOCKS is a protocol to traverse firewalls as described "
"in <a href=\"http://rfc.net/rfc1928.html\">RFC 1928</a>. <p>"
"If you have no idea what this is and if your system administrator doesn't tell "
"you to use it, leave it disabled.</p>"
msgstr ""

#: socks.cpp:277
msgid "kcmsocks"
msgstr "kcmsocks"

#: socks.cpp:277
msgid "KDE SOCKS Control Module"
msgstr "SOCKS учун бошқарув модули"

