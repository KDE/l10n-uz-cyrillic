"error."
msgstr ""

#: kio/global.cpp:868
msgid "Unable to Initialize Input/Output Device"
msgstr ""

#: kio/global.cpp:869
msgid "Could Not Mount Device"
msgstr "Ускунани улаб бўлмади"

